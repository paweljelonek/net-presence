<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetPresence.MainWindow"
        Title="Net Presence - Configuration"
        Width="420"
        CanResize="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Padding="16">

    <StackPanel Spacing="12">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
            <!-- Mode -->
            <TextBlock Text="Mode:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,10"/>
            <ComboBox x:Name="ModeComboBox" Grid.Row="0" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                <ComboBoxItem>Mouse</ComboBoxItem>
                <ComboBoxItem>Keyboard</ComboBoxItem>
                <ComboBoxItem>Both</ComboBoxItem>
                <ComboBoxItem>Scroll</ComboBoxItem>
            </ComboBox>

            <!-- Idle interval -->
            <TextBlock Text="Idle interval (seconds):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,10"/>
            <NumericUpDown x:Name="IntervalNumeric" Grid.Row="1" Grid.Column="1" Value="60" Minimum="5" Maximum="3600" Increment="5" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>

            <!-- Mouse pixels -->
            <TextBlock Text="Mouse movement (px):" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <NumericUpDown x:Name="PixelsNumeric" Grid.Row="2" Grid.Column="1" Value="1" Minimum="1" Maximum="100" Increment="1" HorizontalAlignment="Stretch"/>
        </Grid>

        <!-- Checkboxes -->
        <CheckBox x:Name="CircularCheckBox" Content="Circular mouse movement" IsChecked="False"/>
        <CheckBox x:Name="StartImmediatelyCheckBox" Content="Start keeping presence immediately on launch" IsChecked="True"/>
        <CheckBox x:Name="NotificationCheckBox" Content="Show notification when presence action is performed" IsChecked="False"/>
        <CheckBox x:Name="StartupCheckBox" Content="Launch the application on system startup" IsChecked="False"/>

        <!-- Status -->
        <TextBlock Text="Status: stopped" Opacity="0.6" Margin="0,10,0,10"/>

        <Separator Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,5"/>

        <!-- Buttons -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Content="Start" Grid.Column="0" Width="80" HorizontalContentAlignment="Center"/>
            <Button Content="Cancel" Grid.Column="2" Width="80" HorizontalContentAlignment="Center" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Save" Grid.Column="3" Width="80" HorizontalContentAlignment="Center" Classes="accent" Click="SaveButton_Click"/>
        </Grid>
    </StackPanel>
</Window>
